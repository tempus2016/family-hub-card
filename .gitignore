node_modules/

# dist/ is committed on purpose: HACS serves the built card straight from the
# repo, so the bundle has to be in the tree. Only the one built file belongs.
dist/*
!dist/family-hub-card.js

# Test / tooling output
coverage/
.vitest/
.eslintcache
*.log
npm-debug.log*

# Scratch space: local screenshots, throwaway files and planning notes. Named
# generically on purpose — the ignore has to survive a fresh clone, but the
# repo should not advertise what is kept here.
.tmp/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/
