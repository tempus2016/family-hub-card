node_modules/

# dist/ is committed on purpose: HACS serves the built card straight from the
# repo, so the bundle has to be in the tree. Only the one built file belongs.
dist/*
!dist/family-hub-card.js

# Test / tooling output
coverage/
.vitest/
.eslintcache
*.log
npm-debug.log*

# Scratch space for local screenshots and throwaway files
.tmp/

# Local planning notes. Tracked here rather than in .git/info/exclude, which is
# per-clone: on a fresh clone these stop being ignored and can be committed to
# a public repo by accident.
docs/superpowers/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/
